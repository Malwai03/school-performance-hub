{
  "name": "school-app-backend-functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.config.cjs --runInBand",
    "test:rules": "npx --yes firebase-tools@13.35.1 emulators:exec --project demo-school-rules --config ../../firebase.rules-test.json --only firestore,storage \"npm run test:rules:run\"",
    "test:rules:run": "jest --config jest.rules.config.cjs --runInBand --json --outputFile=rules-test-results.json"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.5",
    "firebase-functions-test": "^3.4.1",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
