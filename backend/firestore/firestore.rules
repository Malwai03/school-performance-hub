rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid);
    }

    function hasUserRecord(schoolId) {
      return signedIn() && exists(userPath(schoolId));
    }

    function userData(schoolId) {
      return get(userPath(schoolId)).data;
    }

    function isAdmin(schoolId) {
      return hasUserRecord(schoolId) && userData(schoolId).role == "ADMIN";
    }

    function isTeacher(schoolId) {
      return hasUserRecord(schoolId) && userData(schoolId).role == "TEACHER";
    }

    function isStudent(schoolId) {
      return hasUserRecord(schoolId) && userData(schoolId).role == "STUDENT";
    }

    // createManagedUserAccount links a student profile through linkedStudentId and uses the
    // student id as the auth uid; older profiles carry studentId. A blank or missing id never matches.
    function isStudentSelf(schoolId, studentId) {
      return isStudent(schoolId) && studentId is string && studentId.size() > 0 && (
        userData(schoolId).get("linkedStudentId", null) == studentId ||
        userData(schoolId).get("studentId", null) == studentId ||
        request.auth.uid == studentId
      );
    }

    function assessmentDoc(schoolId, assessmentId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/assessments/$(assessmentId)).data;
    }

    function teacherAssignmentDocId(sectionId, subjectId) {
      return sectionId + "_" + subjectId + "_" + request.auth.uid;
    }

    function isAssignedTeacherForAssessment(schoolId, assessmentId) {
      let assessment = assessmentDoc(schoolId, assessmentId);
      return isTeacher(schoolId) && assessment != null && exists(
        /databases/$(database)/documents/schools/$(schoolId)/teacherAssignments/$(teacherAssignmentDocId(assessment.sectionId, assessment.subjectId))
      );
    }

    // A teacher's read scope, as onTeacherAssignmentWrite mirrors it onto their profile:
    // assignmentSections maps each of their teacherAssignments ids (<sectionId>_<subjectId>_<uid>) to its
    // section. Read rules check this map instead of calling exists() per document, so a list query with an
    // "in" filter costs no extra document reads per value. Writes still check teacherAssignments directly.
    function teacherAssignmentSections(schoolId) {
      return userData(schoolId).get("assignmentSections", {});
    }

    function teachesSection(schoolId, sectionId) {
      return isTeacher(schoolId) && sectionId is string && sectionId.size() > 0 &&
        sectionId in teacherAssignmentSections(schoolId).values();
    }

    function teachesPair(schoolId, sectionId, subjectId) {
      return isTeacher(schoolId) && sectionId is string && sectionId.size() > 0 &&
        subjectId is string && subjectId.size() > 0 &&
        teacherAssignmentDocId(sectionId, subjectId) in teacherAssignmentSections(schoolId);
    }

    // One document read per assessment: its section and subject.
    function teachesAssessment(schoolId, assessmentId) {
      return isTeacher(schoolId) && assessmentId is string && assessmentId.size() > 0 &&
        teachesAssessmentPair(schoolId, assessmentDoc(schoolId, assessmentId));
    }

    function teachesAssessmentPair(schoolId, assessment) {
      return assessment != null && teachesPair(schoolId, assessment.sectionId, assessment.subjectId);
    }

    function hasValidScoreBounds(schoolId, assessmentId, marks) {
      let assessment = assessmentDoc(schoolId, assessmentId);
      return assessment != null && marks is number &&
        marks >= 0 && marks <= assessment.maxMarks;
    }

    function hasValidScore(schoolId, scoreId) {
      let score = request.resource.data;
      let assessment = assessmentDoc(schoolId, score.assessmentId);
      let student = get(/databases/$(database)/documents/schools/$(schoolId)/students/$(score.studentId)).data;
      return score.scoreId == scoreId &&
        score.assessmentId is string && score.assessmentId.size() > 0 &&
        score.studentId is string && score.studentId.size() > 0 &&
        assessment != null && student != null &&
        assessment.sectionId is string && assessment.sectionId.size() > 0 &&
        student.sectionId == assessment.sectionId &&
        hasValidScoreBounds(schoolId, score.assessmentId, score.obtainedMarks);
    }

    function canWriteScore(schoolId, scoreId) {
      return (isAdmin(schoolId) ||
        isAssignedTeacherForAssessment(schoolId, request.resource.data.assessmentId)) &&
        hasValidScore(schoolId, scoreId);
    }

    match /schools/{schoolId} {
      allow read: if signedIn() && hasUserRecord(schoolId);
      allow write: if isAdmin(schoolId);

      match /users/{uid} {
        allow read: if isAdmin(schoolId) || (signedIn() && request.auth.uid == uid && hasUserRecord(schoolId));
        allow create, update, delete: if isAdmin(schoolId);
      }

      match /sections/{sectionId} {
        allow read: if hasUserRecord(schoolId);
        allow create, update, delete: if isAdmin(schoolId);
      }

      match /subjects/{subjectId} {
        allow read: if hasUserRecord(schoolId);
        allow create, update, delete: if isAdmin(schoolId);
      }

      // Teachers: students of a section they teach any subject in.
      match /students/{studentId} {
        allow read: if isAdmin(schoolId) || isStudentSelf(schoolId, studentId) ||
          teachesSection(schoolId, resource.data.sectionId);
        allow create, update, delete: if isAdmin(schoolId);
      }

      // Teachers: only their own assignments (the app queries teacherUid == their uid).
      match /teacherAssignments/{assignmentId} {
        allow read: if isAdmin(schoolId) ||
          (isTeacher(schoolId) && resource.data.teacherUid == request.auth.uid);
        allow create, update, delete: if isAdmin(schoolId);
      }

      match /assessmentCycles/{cycleId} {
        allow read: if hasUserRecord(schoolId);
        allow create: if isAdmin(schoolId) && request.resource.data.published != true;
        allow update: if isAdmin(schoolId) && !(
          request.resource.data.published == true && resource.data.published != true
        );
        allow delete: if isAdmin(schoolId);
      }

      // Teachers: assessments of a section + subject pair they are assigned to. A list query must pin both
      // fields (subjectId == S plus sectionId == X or sectionId in [...]) for the rule to be provable.
      match /assessments/{assessmentId} {
        allow read: if isAdmin(schoolId) || isStudent(schoolId) ||
          teachesPair(schoolId, resource.data.sectionId, resource.data.subjectId);
        allow create, update, delete: if isAdmin(schoolId);
      }

      // Teachers: marks of assessments in their assigned pairs. Every assessmentId a query can match costs
      // one document read (the assessment), and a query may make only a few, so an "in" query on
      // assessmentId has to stay small (see the teacher scope tests).
      match /scores/{scoreId} {
        allow read: if isAdmin(schoolId) || isStudentSelf(schoolId, resource.data.studentId) ||
          teachesAssessment(schoolId, resource.data.assessmentId);

        allow create: if canWriteScore(schoolId, scoreId);

        // Reassignment requires a separate, audited operation; ordinary grading
        // can change marks/status but never the identity of an existing score.
        allow update: if canWriteScore(schoolId, scoreId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["scoreId", "assessmentId", "studentId"]);

        allow delete: if isAdmin(schoolId);
      }

      // Teachers read no result snapshots: one holds a student's results in every subject, and the app
      // downloads none for teachers.
      match /resultSnapshots/{snapshotId} {
        allow read: if isAdmin(schoolId) || (
          isStudentSelf(schoolId, resource.data.studentId) &&
          get(/databases/$(database)/documents/schools/$(schoolId)/assessmentCycles/$(resource.data.cycleId)).data.published == true
        );
        allow create, update, delete: if false;
      }

      match /sectionAnalytics/{docId} {
        allow read: if hasUserRecord(schoolId);
        allow write: if false;
      }

      match /imports/{importId} {
        allow read, create, update, delete: if isAdmin(schoolId);
      }
    }
  }
}
